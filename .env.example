# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเซิร์ฟเวอร์
# หมายเหตุ: ห้าม commit ไฟล์ .env เข้า git (มีรหัสผ่านอยู่)

NODE_ENV=production
PORT=3000

# ตั้งค่าเมื่อ Plesk mount แอปไว้ใต้ path ย่อย เช่น /finance (เว้นว่างถ้าอยู่ที่ราก)
BASE_PATH=

# ---- ฐานข้อมูล MySQL บน Plesk ----
DB_ENABLED=true
DB_HOST=localhost
DB_PORT=3306
DB_USER=leaf_finance
DB_PASSWORD=เปลี่ยนเป็นรหัสผ่านจริง
DB_NAME=leaf_finance
DB_POOL=5

# ---- การอัปโหลด ----
MAX_UPLOAD_MB=25
# ระยะเวลาที่เก็บผลลัพธ์ไว้ให้ดาวน์โหลดซ้ำ (นาที)
RESULT_TTL_MINUTES=120
